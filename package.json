{
  "name": "@pixodeo/figma-bridge",
  "version": "1.3.2",
  "description": "Local REST and MCP bridge that serves Figma designs to AI coding assistants, from either the Figma plugin or the official REST API",
  "license": "Apache-2.0",
  "author": "Nathan Pixodeo",
  "homepage": "https://github.com/nathanpixodeo/figma-design-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathanpixodeo/figma-design-bridge.git"
  },
  "keywords": [
    "figma",
    "mcp",
    "design-to-code",
    "claude-code",
    "codex"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "figma-bridge": "bin/figma-bridge.js"
  },
  "files": [
    "bin/",
    "server/",
    "plugin/",
    "hooks/",
    ".claude-plugin/",
    "integrations/claude-code/",
    "integrations/codex/",
    "docs/BRIDGE_PROTOCOL.md",
    "docs/SERVER_API.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "!**/*.test.*",
    "!server/data/",
    "!server/config.json",
    "!**/bridge-token.json",
    "!**/.env*",
    "!**/*.log",
    "!**/*.tmp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node server/index.js",
    "mcp": "node server/mcp.mjs",
    "import:figma": "node server/import-figma.mjs",
    "bridge:token": "node server/bridge-token.js",
    "bridge:token:rotate": "node server/bridge-token.js --rotate",
    "bridge:pair": "node server/bridge-pair.js",
    "test": "node --test",
    "inspect": "node server/index.js --inspect"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
